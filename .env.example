# ---- LLM (DeepSeek V4.1 Flash, OpenAI-compatible API) ----
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---- Database ----
DATABASE_URL=postgresql://blend:CHANGE_ME@db:5432/blend?schema=public

# ---- Auth.js ----
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ---- Storage (persistent volume in Coolify) ----
STORAGE_DIR=/data/storage

# ---- Billing (optional; without keys, upgrades are disabled in the UI) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ---- Ops ----
CRON_SECRET=change-me
# Optional: create/refresh an admin and a test account on boot (leave unset to skip)
SEED_ADMIN_PASSWORD=
SEED_TEST_PASSWORD=
