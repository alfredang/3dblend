generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  STARTER
  PRO
}

enum Role {
  user
  assistant
  system
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  passwordHash     String
  image            String?
  plan             Plan     @default(FREE)
  isAdmin          Boolean  @default(false)
  credits          Int      @default(10)
  creditsResetAt   DateTime @default(now())
  createdAt        DateTime @default(now())

  projects      Project[]
  models        Model[]
  likes         Like[]
  transactions  CreditTransaction[]
  subscriptions Subscription[]
  invoices      Invoice[]
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

/// A HitPay recurring-billing subscription for a paid plan.
model Subscription {
  id                String             @id @default(cuid())
  userId            String
  plan              Plan
  status            SubscriptionStatus @default(PENDING)
  provider          String             @default("hitpay")
  providerPlanId    String?
  providerBillingId String?            @unique
  amount            Float
  currency          String             @default("SGD")
  cycle             String             @default("monthly")
  startDate         DateTime?
  currentPeriodEnd  DateTime?
  timesCharged      Int                @default(0)
  cancelledAt       DateTime?
  endsAt            DateTime?
  lastSyncedAt      DateTime?
  raw               Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId, status])
}

/// Auto-generated invoice for every successful subscription charge.
model Invoice {
  id                String        @id @default(cuid())
  number            String        @unique
  userId            String
  subscriptionId    String?
  plan              Plan
  amount            Float
  currency          String        @default("SGD")
  status            String        @default("paid")
  description       String
  periodStart       DateTime
  periodEnd         DateTime
  paidAt            DateTime
  providerPaymentId String?       @unique
  createdAt         DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, paidAt])
}

/// Cache of HitPay subscription-plan ids per plan/price so we create them once.
model ProviderPlan {
  id             String   @id @default(cuid())
  provider       String   @default("hitpay")
  plan           Plan
  amount         Float
  currency       String
  providerPlanId String
  createdAt      DateTime @default(now())

  @@unique([provider, plan, amount, currency])
}

model Project {
  id        String    @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  models    Model[]

  @@index([userId, updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  role      Role
  content   String
  modelId   String?
  imagePath      String?
  attachmentPath String?
  attachmentName String?
  attachmentText String?
  /// Uploaded STL/3MF/Blender model converted to binary STL, usable as the agent's base solid.
  meshPath       String?
  meshStats      Json?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  model     Model?   @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

model Model {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  description String   @default("")
  prompt      String
  spec        Json
  stats       Json
  stlPath     String
  blenderPath String
  version     Int      @default(1)
  isPublic    Boolean  @default(false)
  featured    Boolean  @default(false)
  likesCount  Int      @default(0)
  downloads   Int      @default(0)
  views       Int      @default(0)
  /** Set when this model (or its project) started as a remix of a gallery model. */
  remixOfId   String?
  /** Snapshot "Title by Author" so attribution survives if the original is deleted. */
  attribution String?
  /// Base mesh (uploaded by the user) that this model's spec references via {op:"mesh"}.
  baseMeshPath String?
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  remixOf  Model?    @relation("Remixes", fields: [remixOfId], references: [id], onDelete: SetNull)
  remixes  Model[]   @relation("Remixes")
  likes    Like[]
  messages Message[]

  @@index([isPublic, createdAt])
  @@index([featured])
  @@index([userId])
}

model Like {
  userId    String
  modelId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([userId, modelId])
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
